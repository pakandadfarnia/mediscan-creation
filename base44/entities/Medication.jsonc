{
  "name": "Medication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Brand or product name"
    },
    "category": {
      "type": "string",
      "enum": [
        "prescription",
        "otc",
        "supplement"
      ],
      "default": "prescription",
      "description": "prescription, over-the-counter (otc), or herbal/dietary supplement"
    },
    "generic_name": {
      "type": "string"
    },
    "active_ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active medicinal ingredients, including each component of combination drugs (e.g. oxycodone, acetaminophen)"
    },
    "dose": {
      "type": "string",
      "description": "Strength per unit, e.g. 500 mg"
    },
    "form": {
      "type": "string",
      "description": "Tablet, capsule, syrup, etc."
    },
    "frequency": {
      "type": "string",
      "description": "How often it is taken"
    },
    "route": {
      "type": "string",
      "description": "Oral, topical, injection, etc."
    },
    "quantity": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "description": "What it is used for"
    },
    "inactive_ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fillers, binders, dyes, preservatives"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "allergy_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "allergen": {
            "type": "string"
          },
          "ingredient": {
            "type": "string"
          }
        }
      },
      "description": "Saved matches between this medication's inactive ingredients and the user's allergies"
    },
    "drug_interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "other_med": {
            "type": "string"
          },
          "ingredient": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "danger",
              "caution"
            ]
          }
        }
      }
    },
    "food_interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "food": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "danger",
              "caution"
            ]
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}