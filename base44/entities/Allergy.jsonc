{
  "name": "Allergy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The allergen, e.g. Lactose, Yellow No. 5, Gluten"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "chemical",
        "other"
      ],
      "default": "other"
    },
    "reaction": {
      "type": "string",
      "description": "What happens when exposed, e.g. rash, swelling, difficulty breathing"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe"
      ],
      "default": "mild"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}