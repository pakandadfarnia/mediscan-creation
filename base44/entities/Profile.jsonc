{
  "name": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "height": {
      "type": "string",
      "description": "e.g. 170 cm"
    },
    "weight": {
      "type": "string",
      "description": "e.g. 70 kg"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "zh",
        "pt",
        "ar"
      ],
      "default": "en"
    }
  },
  "required": [
    "language"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}